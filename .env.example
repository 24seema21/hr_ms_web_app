# Copy to `.env.local` and adjust. `.env.local` is gitignored; this file is not.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. That
# prefix is a safety rail: it makes leaking a server secret into client-side
# JavaScript a deliberate act rather than an accident.
#
# Never put an API key, database URL or any other secret in here. Everything in
# this file ends up readable in the shipped JavaScript.

# Base URL of the HRMS backend. Unused in Phase 1 (auth is mocked in
# src/features/auth/api/authApi.ts) and consumed from Phase 2 onward.
VITE_API_BASE_URL=http://localhost:8080/api
